#include <windows.h>
#include "resource.h"
// v2.10: single source of truth — tools/incr_build.bat regenerates this
// on every app build (title bar and About read it too).
#include "version.h"

// App logo: blue rounded tile + white drive + green down arrow (space freed).
IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MINISYS_VERSION_RC
 PRODUCTVERSION MINISYS_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MiniSys"
            VALUE "FileDescription", "MiniSys - Disk Cleaner & Migrator"
            VALUE "FileVersion", MINISYS_VERSION_STR
            VALUE "InternalName", "MiniSys"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "MiniSys.exe"
            VALUE "ProductName", "MiniSys"
            VALUE "ProductVersion", MINISYS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
