{
  "version": 2,
  "rules": [
    { "id": "user-temp",  "category": "System Temp", "title": "用户临时文件夹", "path": "%TEMP%", "mode": "subtree", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "windows-temp", "category": "System Temp", "title": "Windows 临时文件夹", "path": "%SystemRoot%\\Temp", "mode": "subtree", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "thumbnails", "category": "Explorer", "title": "缩略图缓存", "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer", "mode": "children", "childPattern": "thumbcache_*.db", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "d3dscache", "category": "Explorer", "title": "D3D 着色器缓存", "path": "%LOCALAPPDATA%\\D3DSCache", "mode": "subtree", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "wer", "category": "Explorer", "title": "错误报告 (WER)", "path": "%LOCALAPPDATA%\\Microsoft\\Windows\\WER", "mode": "subtree", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "font-cache", "category": "Explorer", "title": "字体缓存", "path": "%SystemDrive%\\Windows\\ServiceProfiles\\LocalService\\AppData\\Local\\FontCache", "mode": "subtree", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "edge-profiles", "category": "Browser Cache", "title": "Edge 缓存 (所有 Profile)", "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data", "mode": "profiles", "profileNames": "Cache;Code Cache;GPUCache", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "chrome-profiles", "category": "Browser Cache", "title": "Chrome 缓存 (所有 Profile)", "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data", "mode": "profiles", "profileNames": "Cache;Code Cache;GPUCache", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "firefox-profiles", "category": "Browser Cache", "title": "Firefox 缓存 (所有 Profile)", "path": "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles", "mode": "profiles", "profileNames": "cache2", "riskLevel": "safe", "strategy": "quarantine", "recommended": true },
    { "id": "dev-npm", "category": "Dev Cache", "title": "npm 缓存", "path": "%LOCALAPPDATA%\\npm-cache", "mode": "subtree", "riskLevel": "safe", "minAgeDays": 30, "strategy": "quarantine", "recommended": true },
    { "id": "dev-pip", "category": "Dev Cache", "title": "pip 缓存", "path": "%LOCALAPPDATA%\\pip\\cache", "mode": "subtree", "riskLevel": "safe", "minAgeDays": 30, "strategy": "quarantine", "recommended": true },
    { "id": "dev-cargo", "category": "Dev Cache", "title": "cargo 缓存", "path": "%USERPROFILE%\\.cargo\\registry", "mode": "subtree", "riskLevel": "safe", "minAgeDays": 30, "strategy": "quarantine", "recommended": true },
    { "id": "dev-maven", "category": "Dev Cache", "title": "Maven 仓库", "path": "%USERPROFILE%\\.m2\\repository", "mode": "subtree", "riskLevel": "safe", "minAgeDays": 30, "strategy": "quarantine", "recommended": true },
    { "id": "dev-gradle", "category": "Dev Cache", "title": "Gradle 缓存", "path": "%USERPROFILE%\\.gradle\\caches", "mode": "subtree", "riskLevel": "safe", "minAgeDays": 30, "strategy": "quarantine", "recommended": true },
    { "id": "dev-nuget", "category": "Dev Cache", "title": "NuGet 包缓存", "path": "%USERPROFILE%\\.nuget\\packages", "mode": "subtree", "riskLevel": "safe", "minAgeDays": 30, "strategy": "quarantine", "recommended": true },

    { "id": "wu-download", "category": "Windows Update", "title": "更新下载缓存", "path": "%SystemRoot%\\SoftwareDistribution\\Download", "mode": "subtree", "riskLevel": "cautious", "strategy": "quarantine", "recommended": false },
    { "id": "cbs-logs", "category": "Windows Logs", "title": "CBS 日志", "path": "%SystemRoot%\\Logs\\CBS", "mode": "subtree", "riskLevel": "cautious", "strategy": "quarantine", "recommended": false },
    { "id": "dism-logs", "category": "Windows Logs", "title": "DISM 日志", "path": "%SystemRoot%\\Logs\\DISM", "mode": "subtree", "riskLevel": "cautious", "strategy": "quarantine", "recommended": false },
    { "id": "minidump", "category": "Windows Logs", "title": "蓝屏转储 (Minidump)", "path": "%SystemRoot%\\Minidump", "mode": "subtree", "riskLevel": "cautious", "strategy": "quarantine", "recommended": false },
    { "id": "do-cache", "category": "Windows Update", "title": "传递优化缓存", "path": "%ProgramData%\\Microsoft\\Windows\\DeliveryOptimization\\Cache", "mode": "subtree", "riskLevel": "cautious", "strategy": "quarantine", "recommended": false },
    { "id": "wechat-files", "category": "Chat Files", "title": "微信接收文件 (按账号)", "path": "%USERPROFILE%\\Documents\\WeChat Files", "mode": "children", "riskLevel": "cautious", "minAgeDays": 30, "strategy": "quarantine", "recommended": false },
    { "id": "qq-files", "category": "Chat Files", "title": "QQ 接收文件 (按账号)", "path": "%USERPROFILE%\\Documents\\Tencent Files", "mode": "children", "riskLevel": "cautious", "minAgeDays": 30, "strategy": "quarantine", "recommended": false },

    { "id": "winsxs", "category": "System Component", "title": "组件存储 (WinSxS)", "path": "%SystemRoot%\\WinSxS", "mode": "subtree", "riskLevel": "advanced", "strategy": "delegate", "recommended": false, "command": "Dism.exe /Online /Cleanup-Image /StartComponentCleanup", "detailHint": "仅可通过 DISM 组件清理，不可直接删除" },
    { "id": "windows-old", "category": "System Component", "title": "旧系统备份 (Windows.old)", "path": "%SystemDrive%\\Windows.old", "mode": "subtree", "riskLevel": "advanced", "strategy": "delegate", "recommended": false, "command": "cleanmgr", "detailHint": "建议通过磁盘清理工具处理" },
    { "id": "hiberfil", "category": "System Component", "title": "休眠文件 hiberfil.sys", "path": "%SystemDrive%\\hiberfil.sys", "mode": "subtree", "riskLevel": "advanced", "strategy": "delegate", "recommended": false, "command": "powercfg /h off", "detailHint": "关闭休眠后自动删除" },

    { "id": "pagefile", "category": "System Reserved", "title": "页面文件 pagefile.sys", "path": "%SystemDrive%\\pagefile.sys", "mode": "subtree", "riskLevel": "info", "strategy": "info", "recommended": false, "detailHint": "通过 系统属性→高级→虚拟内存 调整" },
    { "id": "swapfile", "category": "System Reserved", "title": "交换文件 swapfile.sys", "path": "%SystemDrive%\\swapfile.sys", "mode": "subtree", "riskLevel": "info", "strategy": "info", "recommended": false, "detailHint": "系统管理，不可直接删除" }
  ]
}
